# =============================================================================
# .env.example — ONE-CLICK ML PIPELINE
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env.production
#   2. Fill in all values marked as CHANGE_ME
#   3. NEVER commit .env.production to Git
# =============================================================================

# ── Image Tag (set by CI/CD to Git SHA for immutable tags) ──────────────────
IMAGE_TAG=latest

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_EXPERIMENT_NAME=One_Click_ML_Experiment

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://CHANGE_ME.com

# ── Domain (used by nginx config) ────────────────────────────────────────────
DOMAIN=CHANGE_ME.com
